# Database
POSTGRES_DB=chessdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password

# Backend
JWT_SECRET=change_me_min_32_characters_long
ASPNETCORE_ENVIRONMENT=Production

# URLs
FRONTEND_URL=http://localhost
BACKEND_URL=http://localhost:5000

# SignalR
VITE_API_URL=/api
VITE_SIGNALR_URL=/hubs/chess

# Stockfish (в Docker используется /usr/games/stockfish)
# Для Windows локально: C:\stockfish\stockfish.exe
# Для Linux/Mac: stockfish
Stockfish__Path=stockfish

# Ollama (опционально, только для AI Coach)
Ollama__Url=http://localhost:11434

# Tournament Cleanup (опционально)
TournamentCleanup__Enabled=true
TournamentCleanup__CheckIntervalHours=1
TournamentCleanup__CleanupDelayDays=1
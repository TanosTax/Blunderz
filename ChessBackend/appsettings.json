{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=chessdb;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "your-secret-key-min-32-characters-long",
    "Issuer": "ChessBackend",
    "Audience": "ChessFrontend"
  },
  "Stockfish": {
    "Path": "stockfish"
  },
  "TournamentCleanup": {
    "Enabled": true,
    "CheckIntervalHours": 1,
    "CleanupDelayDays": 1
  }
}